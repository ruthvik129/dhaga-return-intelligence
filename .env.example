REVIEW_MINUTES_PER_ROW=2.5


MAX_CONCURRENCY=16
MAX_TRANSPORT_RETRIES=3
REQUESTS_PER_SECOND=0        
ENABLE_RESPONSE_CACHE=1

INJECT_SCHEMA_FAULTS=0
